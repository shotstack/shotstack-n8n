{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		// No incremental build. The cache used to live in dist and was the largest
		// file in the published package; moving it out meant deleting dist no
		// longer invalidated it, so a clean build emitted nothing. A full build
		// takes about two seconds, so the cache was never worth either problem.
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/"
	},
	// package.json is deliberately absent. Including it emitted a second copy at
	// dist/package.json whose n8n paths are wrong from that location, and no
	// source file imports it.
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json"]
}
