{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		// Keep incremental builds off. The cache outlives a deleted dist, so a
		// clean build then emits nothing.
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/"
	},
	// Do not add package.json here. It emits a second copy at dist/package.json
	// whose n8n paths are wrong from that folder.
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json"]
}
