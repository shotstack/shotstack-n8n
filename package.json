{
  "name": "@shotstack/n8n-nodes-shotstack",
  "version": "0.1.0",
  "description": "Render video and images from JSON with the Shotstack API",
  "license": "MIT",
  "homepage": "https://shotstack.io",
  "keywords": [
    "n8n-community-node-package",
    "shotstack",
    "video",
    "video-editing",
    "video-api",
    "video-automation",
    "json-to-video",
    "n8n"
  ],
  "author": {
    "name": "Shotstack",
    "email": "support@shotstack.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shotstack/shotstack-n8n.git"
  },
  "bugs": {
    "url": "https://github.com/shotstack/shotstack-n8n/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run gen && n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "npm run gen && n8n-node lint",
    "lint:fix": "npm run gen && n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "npm run build && node test/package-loads.mjs && node test/credential-host-scope.mjs && node test/docs-match-ui.mjs && node test/environment-mapping.mjs && node test/wait-and-backoff.mjs && node test/submit-guards.mjs",
    "gen": "node scripts/build-user-agent.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ShotstackApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Shotstack/Shotstack.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.44.4",
    "@shotstack/schemas": "1.17.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.19"
  },
  "auto-changelog": {
    "output": ".auto-changelog.md"
  }
}
